---
layout: default
---
<div class="post about-page">

  <!-- ═══════════════════════════════════════════════════════════════ HERO -->
  <section class="hero-section">
    <div class="hero-inner">

      <div class="hero-text">
        <p class="hero-greeting">Hi! I'm Seba.</p>
        <h1 class="hero-name">
          {% if site.title == 'blank' %}
            {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="hero-subtitle" id="hero-subtitle" data-text="{{ page.subtitle }}"></p>
        <p class="hero-tagline">
          Working at the intersection of quantitative economics,<br class="d-none d-md-inline">
          data science, and applied research.
        </p>
        <div class="hero-ctas">
          <a href="{{ '/projects/' | relative_url }}" class="hero-btn hero-btn-primary">
            projects
          </a>
          <a href="{{ '/cv/' | relative_url }}" class="hero-btn hero-btn-ghost">
            curriculum vitae
          </a>
          <a href="/assets/pdf/Sebasti%C3%A1n%20L.%20Manzi%20-%20Resume%20%28EN%29.pdf" class="hero-btn hero-btn-ghost" target="_blank" rel="noopener">
            <i class="fa-solid fa-download fa-xs"></i>&nbsp;resume
          </a>
        </div>
      </div>

      {% if page.profile and page.profile.image %}
        <div class="hero-photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'hero-profile-img rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'hero-profile-img' %}
          {% endif %}
          {%
            include figure.liquid loading="eager" path=profile_image_path
            class=profile_image_class sizes="200px" alt="Profile photo"
            cache_bust=true
          %}
        </div>
      {% endif %}

    </div><!-- /.hero-inner -->

    <!-- Skill tags -->
    <div class="skill-tags">
      <span class="skill-tag">Python</span>
      <span class="skill-tag">R</span>
      <span class="skill-tag">SQL</span>
      <span class="skill-tag">STATA</span>
      <span class="skill-tag">Plotly</span>
      <span class="skill-tag">Leaflet</span>
      <span class="skill-tag">Econometrics</span>
      <span class="skill-tag">NLP</span>
      <span class="skill-tag">LaTeX</span>
    </div>

  </section><!-- /.hero-section -->

  <!-- ═══════════════════════════════════════════════════════════════ BIO -->
  <article class="bio-section">

    <div class="clearfix bio-content">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2><a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}

  </article><!-- /.bio-section -->

  <!-- ═══════════════════════════════════════════════ SELECTED PROJECTS -->
  <section class="home-section" id="projects">
    <div class="home-section-head">
      <h2 class="home-section-title">selected projects</h2>
      <a class="home-section-link" href="{{ '/projects/' | relative_url }}">view all →</a>
    </div>
    {% assign featured_titles = "TTS,Econ,Ma-py-tas" | split: "," %}
    <div class="projects home-projects">
      <div class="row row-cols-1 row-cols-md-3">
        {% for t in featured_titles %}
          {% assign project = site.projects | where: "title", t | first %}
          {% if project %}{% include projects.liquid %}{% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ SELECTED PAPERS -->
  {% if page.selected_papers %}
    <section class="home-section" id="publications">
      <div class="home-section-head">
        <h2 class="home-section-title">selected publications</h2>
        <a class="home-section-link" href="{{ '/publications/' | relative_url }}">view all →</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- ═══════════════════════════════════════════════════════ BEYOND WORK -->
  <section class="home-section" id="beyond">
    <div class="home-section-head">
      <h2 class="home-section-title">beyond work</h2>
    </div>
    <ul class="beyond-list">
      <li>
        <strong>Proudly nerd.</strong> I'll spend hours — genuinely, hours — watching videos on
        the most varied topics: computer science, electrical engineering, physics, mathematics,
        statistics, you name it. I also take part — anonymously, for now — in blogs and social
        media, weighing in on them.
      </li>
      <li>
        <strong>Huge Racing fan</strong> 🩵🤍 — the great passion of my life.
        If you can't find me working, you'll find me at the
        <a href="https://en.wikipedia.org/wiki/Estadio_Presidente_Perón" target="_blank" rel="noopener">Cilindro de Avellaneda</a>.
      </li>
      <li>
        <strong>In love with Buenos Aires</strong>, a perfect city. Its café culture and
        late-night bookstores, the food — from the corner pizzería to a proper asado — the music,
        the architecture, and, of course, the football: I'm convinced it's one of the best cities
        in the world to live in, and I never get tired of it.
      </li>
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ CONTACT -->
  {% if page.social %}
    <section class="home-section" id="contact">
      <div class="home-section-head">
        <h2 class="home-section-title">let's talk</h2>
        <a class="home-section-link" href="{{ '/contact/' | relative_url }}">contact page →</a>
      </div>
      <p class="home-contact-line">
        Got a project, a role, or an idea worth building? Reach me at
        <a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>.
      </p>
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    </section>
  {% endif %}

  {% if site.newsletter.enabled and site.footer_fixed %}
    <div class="bio-section">
      {% include scripts/newsletter.liquid center=true %}
    </div>
  {% endif %}

</div><!-- /.post -->

<script>
(function () {
  var el = document.getElementById('hero-subtitle');
  if (!el) return;
  var text = el.getAttribute('data-text') || '';
  var i = 0;
  var speed = 38;
  el.classList.add('typewriter-active');
  function type() {
    if (i < text.length) {
      el.textContent += text.charAt(i);
      i++;
      setTimeout(type, speed);
    } else {
      el.classList.remove('typewriter-active');
    }
  }
  setTimeout(type, 300);
})();
</script>
