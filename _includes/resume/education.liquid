<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="w-100">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.studyType }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.9rem; font-style: italic; font-weight: 400;">{{ content.institution }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.875rem; color: var(--global-text-color-light); font-weight: 400;">{{ content.location }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.875rem; color: var(--global-theme-color); font-weight: 500;">{{ content.date }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.9rem; font-style: italic; font-weight: 400;">{{ content.area }}</h6>
          <p class="ml-1 ml-md-4 mt-1" style="font-size: 0.875rem; font-weight: 400; line-height: 1.6; color: var(--global-text-color);">{{ content.summary }}</p>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
