<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="w-100">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <p class="ml-1 ml-md-4 mt-1" style="font-size: 0.875rem; font-weight: 400; line-height: 1.6; color: var(--global-text-color);">{{ content.summary }}</p>
          <ul class="items" style="list-style-type: none; font-size: 0.875rem; padding-left: 1.25rem; margin: 0;">
            {% for item in content.highlights %}
              <li>
                <span class="item" style="color: var(--global-theme-color);">#{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
